# Paths may be absolute or relative to services/asr.
ASR_MODELS_DIR=models
ASR_RUKK_MODEL_DIR=models/asr/rukk
ASR_DIARIZATION_MODEL_DIR=models/diarization
ASR_LLM_MODEL_DIR=models/llm

# auto selects Apple Metal (MPS) only when PyTorch can use it; otherwise CPU.
ASR_DEVICE=auto
ASR_FFMPEG_BINARY=ffmpeg
ASR_FFPROBE_BINARY=ffprobe

# Files in this directory are short-lived: they are deleted after preparation.
ASR_RUNTIME_DIR=runtime
ASR_MAX_UPLOAD_BYTES=1073741824
ASR_MAX_AUDIO_DURATION_SECONDS=14400
ASR_CHUNK_DURATION_SECONDS=18
ASR_CHUNK_OVERLAP_SECONDS=1
ASR_VAD_THRESHOLD_DB=-45
ASR_VAD_MIN_SPEECH_SECONDS=0.3
ASR_VAD_MIN_SILENCE_SECONDS=0.5

# The Next.js app is the only intended browser client in local development.
ASR_ALLOWED_ORIGINS=http://localhost:3000
